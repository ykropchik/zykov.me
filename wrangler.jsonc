{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zykov-me",
	"compatibility_date": "2026-10-17",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	}
}
