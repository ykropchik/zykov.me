{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zykov-me",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-17",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		// Everything else is served as a static asset and never invokes the Worker,
		// so it doesn't count against the daily request limit.
		"run_worker_first": ["/analytics"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zykov-me-analytics",
			"database_id": "10511218-cf38-4bab-a551-8a0fc613b898",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	}
}
